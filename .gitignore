# ── Dependencies ───────────────────────────────────────────────────────────
node_modules/
.pnp/
.pnp.js

# ── Build-output ───────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
*.local

# ── Geheimen — NOOIT committen ─────────────────────────────────────────────
# Alleen .env.example hoort in git. Alle echte waarden blijven lokaal of
# staan in Netlify environment variables.
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json
serviceAccountKey*.json

# ── Netlify ────────────────────────────────────────────────────────────────
.netlify/

# ── Caches & tooling ───────────────────────────────────────────────────────
.vite/
.cache/
coverage/
*.tsbuildinfo
.eslintcache
.prettiercache

# ── Editors ────────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# ── OS ─────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ── Logs ───────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# ── Projectspecifiek ───────────────────────────────────────────────────────
# Nooit testdocumenten met echte contractgegevens in de repo.
/testdocumenten/
*.aannemingsovereenkomst.pdf

# Lokale backups. Een .woningdossier is versleuteld, maar het is nog steeds
# het volledige dossier van een echte woning — die hoort niet in git. De
# golden fixtures zijn de enige uitzondering: die zijn synthetisch en moeten
# juist wél mee, want verify-backup draait erop.
*.woningdossier
!tests/fixtures/*.woningdossier
!test/fixtures/backups/*.woningdossier

# ── Artefacten van de FUSE-mount ───────────────────────────────────────────
# Wordt een bestand vervangen terwijl het nog ergens open staat, dan laat de
# mount de oude inhoud achter als `.fuse_hidden<hex>`. Het zijn volledige
# kopieën van broncodebestanden — op 2 augustus dertien stuks, samen 312 kB —
# en zonder deze regel belanden ze in de eerstvolgende `git add .`.
#
# Ze verdwijnen vanzelf zodra het proces dat ze openhield stopt. Blijven ze
# staan, dan is het veilig ze te verwijderen: het zijn geen originelen, de
# echte bestanden staan er gewoon naast.
.fuse_hidden*
