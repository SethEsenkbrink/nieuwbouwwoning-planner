rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// Firestore Security Rules — Nieuwbouwplanner
//
// Uitgangspunt: DEFAULT DENY. Alles is verboden tenzij hieronder expliciet
// toegestaan. Er is bewust géén catch-all match aan het eind die iets toestaat.
//
// Deze rules zijn de ENIGE beveiligingslaag tussen een gebruiker en de data van
// een ander. De Firebase web-config in de bundle is publiek; iedereen kan de
// client-SDK aanroepen met een eigen account. Wat hier niet dichtgetimmerd is,
// is open.
//
// Testen:  npm run rules:test   (draait tegen de lokale emulator)
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Hulpfuncties ─────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // De enige autorisatieregel die telt: het pad-segment {uid} moet gelijk
    // zijn aan de uid uit het geverifieerde token.
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Voorkomt dat één document de database opblaast of als opslagplek voor
    // documentinhoud misbruikt wordt (PROJECT.md §3, constraint C2).
    //
    // LET OP — `.data` is essentieel en is hier ooit vergeten.
    // `request.resource` is een Resource-object; de velden van het document
    // zitten in `request.resource.data`. `request.resource.size()` telt dus
    // niet de velden maar de eigenschappen van de wrapper: een klein, constant
    // getal dat altijd onder elke grens ligt. De check deed daardoor niets, de
    // rules compileerden gewoon, en alle andere tests bleven groen.
    // Gevonden in sessie 03 toen de rules-tests voor het eerst draaiden.
    function withinSizeLimit() {
      return request.resource.data.size() < 20;
    }

    // Zelfde doel, maar met een eigen grens. Nodig sinds `projects` de
    // opleverband erbij kreeg (6 velden, ADR-0008): 15 velden zit te dicht op
    // de standaardgrens van 20 om nog iets te kunnen toevoegen.
    function withinSize(max) {
      return request.resource.data.size() < max;
    }

    function isString(value, maxLen) {
      return value is string && value.size() <= maxLen;
    }

    // Optioneel veld: mag ontbreken, maar als het er is moet het kloppen.
    function optionalString(data, field, maxLen) {
      return !(field in data) || data[field] == null || isString(data[field], maxLen);
    }

    function optionalNumber(data, field) {
      return !(field in data)
        || data[field] == null
        || (data[field] is number && data[field] >= 0 && data[field] <= 100000000);
    }

    function optionalTimestamp(data, field) {
      return !(field in data) || data[field] == null || data[field] is timestamp;
    }

    function isOneOf(value, allowed) {
      return value is string && value in allowed;
    }

    // Verplicht geheel getal binnen een bereik. Gebruikt voor aanlooptijd,
    // annuleertermijn en offset — waarden waar de rekenmotor op vertrouwt.
    function isInt(value, min, max) {
      return value is int && value >= min && value <= max;
    }

    function optionalInt(data, field, min, max) {
      return !(field in data) || data[field] == null || isInt(data[field], min, max);
    }

    // ── Gedeelde waardelijsten ───────────────────────────────────────────
    // Deze acht bouwmomenten staan óók in src/types/model.ts (AnkerType) en in
    // docs/2026-07-29-betrokkenen-standaardlijst.md. Wijzig je er één, wijzig
    // dan alle drie.

    function ankerTypes() {
      return ['start_bouw', 'begane_grond_gestort', 'ruwbouw_gereed',
              'wind_waterdicht', 'dekvloer_gestort', 'oplevering',
              'sleuteloverdracht', 'einde_onderhoudstermijn'];
    }

    // Het 5%-opschortingsrecht (ADR-0012). Alleen de keuze en het bedrag; de
    // uiterste datum wordt afgeleid en dus niet opgeslagen.
    function geldigeOpschorting(data) {
      return (!('opschortingStatus' in data) || data.opschortingStatus == null
              || isOneOf(data.opschortingStatus,
                         ['onbekend', 'niet_gebruikt', 'in_depot', 'vrijgegeven']))
        && optionalNumber(data, 'opschortingBedrag')
        && optionalString(data, 'opschortingNotitie', 2000);
    }

    // De opleverdatum als band met een staat (ADR-0008, principe 1). Alle
    // velden zijn optioneel: een project mag bestaan voordat er ook maar één
    // datum bekend is. Wat er staat, moet wel kloppen.
    function geldigeOpleverband(data) {
      return (!('opleverStatus' in data) || data.opleverStatus == null
              || isOneOf(data.opleverStatus,
                         ['indicatief', 'bandbreedte', 'aangezegd']))
        && optionalTimestamp(data, 'opleverVroegst')
        && optionalTimestamp(data, 'opleverVerwacht')
        && optionalTimestamp(data, 'opleverLaatst')
        && optionalString(data, 'opleverBron', 300)
        && optionalTimestamp(data, 'opleverBronDatum');
    }

    // Het woningdossier (ADR-0010, ADR-0013). Twee velden op het project:
    // de fase, en het paspoort als GENESTE MAP.
    //
    // WAAROM EEN MAP EN GEEN LOSSE VELDEN.
    // `withinSize(25)` telt met `request.resource.data.size()`, en dat telt een
    // map als ÉÉN veld. Het paspoort heeft er dertien; los zou het de grens
    // breken en moest de limiet omhoog — precies de bescherming uit constraint
    // C2 die dan verwatert. Zie ADR-0013 §5.
    //
    // De keerzijde: de grootte van de map wordt niet meegeteld in de
    // documentlimiet, dus hij krijgt hier een eigen begrenzing. Zonder die
    // check zou het paspoort de opslagplek zijn die C2 juist uitsluit.
    function geldigWoningdossier(data) {
      return (!('woningStatus' in data) || data.woningStatus == null
              || isOneOf(data.woningStatus, ['in_aanbouw', 'opgeleverd']))
        && geldigPaspoort(data);
    }

    function geldigPaspoort(data) {
      return !('woningpaspoort' in data)
        || data.woningpaspoort == null
        || (data.woningpaspoort is map
            && data.woningpaspoort.size() <= 13
            && optionalString(data.woningpaspoort, 'adres', 200)
            && optionalString(data.woningpaspoort, 'postcode', 10)
            && optionalString(data.woningpaspoort, 'plaats', 100)
            && (!('woningtype' in data.woningpaspoort)
                || data.woningpaspoort.woningtype == null
                || isOneOf(data.woningpaspoort.woningtype, woningtypes()))
            && optionalInt(data.woningpaspoort, 'bouwjaar', 1800, 2200)
            && optionalNumber(data.woningpaspoort, 'woonoppervlakte')
            && optionalNumber(data.woningpaspoort, 'perceeloppervlakte')
            && (!('energielabel' in data.woningpaspoort)
                || data.woningpaspoort.energielabel == null
                || isOneOf(data.woningpaspoort.energielabel, energielabels()))
            && optionalString(data.woningpaspoort, 'energielabelRegistratie', 60)
            && optionalTimestamp(data.woningpaspoort, 'energielabelOpnameDatum')
            && optionalString(data.woningpaspoort, 'waarborgpolisnummer', 60)
            && optionalString(data.woningpaspoort, 'notaris', 200)
            && optionalString(data.woningpaspoort, 'hypotheekverstrekker', 200));
    }

    // Dezelfde lijsten staan in src/types/model.ts (Woningtype, Energielabel)
    // en worden door `npm run verify:rules` op pariteit gecontroleerd.
    function woningtypes() {
      return ['tussenwoning', 'hoekwoning', 'twee_onder_een_kap', 'vrijstaand',
              'appartement', 'benedenwoning', 'bovenwoning', 'overig'];
    }

    // De labelschaal volgens NTA 8800. Wettelijk vastgelegd, dus gesloten.
    function energielabels() {
      return ['A+++++', 'A++++', 'A+++', 'A++', 'A+', 'A',
              'B', 'C', 'D', 'E', 'F', 'G'];
    }

    // Staat óók in src/types/model.ts (Metersoort, Metereenheid); pariteit
    // wordt bewaakt door `npm run verify:rules`.
    //
    // De stroomregisters volgen de Nederlandse praktijk: een aansluiting heeft
    // ófwel één register (enkeltarief) ófwel twee (normaal 1.8.2 / dal 1.8.1),
    // en bij zonnepanelen komt daar hetzelfde aantal teruglever-registers bij
    // (2.8.2 / 2.8.1). `overig` is er zodat een tussenmeter op de warmtepomp of
    // een laadpaal niet op een verouderde lijst stukloopt.
    function metersoorten() {
      return ['stroom_enkel', 'stroom_normaal', 'stroom_dal',
              'teruglevering_enkel', 'teruglevering_normaal',
              'teruglevering_dal', 'gas', 'water', 'warmte', 'overig'];
    }

    function metereenheden() {
      return ['kWh', 'm3', 'GJ'];
    }

    // Staat óók in src/types/model.ts (OnderdeelCategorie); pariteit wordt
    // bewaakt door `npm run verify:rules`.
    function onderdeelCategorieen() {
      return ['verwarming', 'ventilatie', 'warm_water', 'elektra', 'opwekking',
              'opslag', 'water', 'zonwering', 'dak', 'gevel', 'sanitair',
              'beveiliging', 'overig'];
    }

    // De vrije specs-map van een onderdeel (ADR-0013 §1).
    //
    // Alleen begrensd op AANTAL, niet op sleutelnamen: de bibliotheek stelt
    // velden voor, maar eigen sleutels moeten kunnen. De inhoud wordt in de
    // converter op stringtype en lengte geschoond; hier gaat het puur om de
    // C2-bescherming — een map die als opslagbak gebruikt kan worden.
    //
    // Firestore-rules kunnen niet over de waarden van een map itereren, dus de
    // waardelengte is hier niet af te dwingen. Het aantal wél, en dat is de
    // grens die telt: 30 specs à 300 tekens is nog steeds een gegevensveld en
    // geen bestand.
    function geldigeSpecs(data) {
      return !('specs' in data)
        || data.specs == null
        || (data.specs is map && data.specs.size() <= 30);
    }

    // Een wettelijke meld- of registratieplicht bij een onderdeel
    // (ADR-0013 §3). `instantie` is verplicht zodra de map bestaat: zonder wie
    // weet je wel dát er iets moet, maar niet waar.
    function geldigeRegistratieplicht(data) {
      return !('registratieplicht' in data)
        || data.registratieplicht == null
        || (data.registratieplicht is map
            && data.registratieplicht.size() <= 4
            && isString(data.registratieplicht.instantie, 200)
            && data.registratieplicht.instantie.size() > 0
            && optionalTimestamp(data.registratieplicht, 'aangemeldOp')
            && optionalString(data.registratieplicht, 'referentie', 120)
            && optionalString(data.registratieplicht, 'toelichting', 2000));
    }


    // ── users/{uid} ──────────────────────────────────────────────────────
    // Profielgegevens van de gebruiker zelf. Bewust minimaal: we slaan hier
    // geen e-mailadres op, dat zit al in Firebase Auth.

    match /users/{uid} {
      allow get, list: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && withinSizeLimit()
        && optionalString(request.resource.data, 'weergavenaam', 100);
      allow delete: if isOwner(uid);


      // ── projects/{projectId} ───────────────────────────────────────────

      match /projects/{projectId} {
        allow get, list: if isOwner(uid);
        allow delete: if isOwner(uid);

        allow create: if isOwner(uid)
          && withinSize(25)
          && isString(request.resource.data.naam, 120)
          && request.resource.data.naam.size() > 0
          && optionalString(request.resource.data, 'bouwnummer', 40)
          && optionalString(request.resource.data, 'projectnaam', 120)
          && optionalString(request.resource.data, 'aannemer', 120)
          && (!('garantiewaarborg' in request.resource.data)
              || isOneOf(request.resource.data.garantiewaarborg,
                         ['woningborg', 'swk', 'geen', 'anders']))
          && optionalNumber(request.resource.data, 'koopsom')
          && optionalNumber(request.resource.data, 'meerwerkbudget')
          && geldigeOpschorting(request.resource.data)
          && geldigeOpleverband(request.resource.data)
          && geldigWoningdossier(request.resource.data)
          && request.resource.data.aangemaaktOp == request.time;

        allow update: if isOwner(uid)
          && withinSize(25)
          && isString(request.resource.data.naam, 120)
          && request.resource.data.naam.size() > 0
          && optionalString(request.resource.data, 'bouwnummer', 40)
          && optionalString(request.resource.data, 'projectnaam', 120)
          && optionalString(request.resource.data, 'aannemer', 120)
          && (!('garantiewaarborg' in request.resource.data)
              || isOneOf(request.resource.data.garantiewaarborg,
                         ['woningborg', 'swk', 'geen', 'anders']))
          && optionalNumber(request.resource.data, 'koopsom')
          && optionalNumber(request.resource.data, 'meerwerkbudget')
          && geldigeOpschorting(request.resource.data)
          && geldigeOpleverband(request.resource.data)
          && geldigWoningdossier(request.resource.data)
          // aangemaaktOp is onveranderlijk.
          && request.resource.data.aangemaaktOp == resource.data.aangemaaktOp;


        // ── ankers/{ankerId} — bouwmomenten ──────────────────────────────
        // Waaraan afspraken hangen. De datum is `verwachtOp` en mag schuiven;
        // dat schuiven is nou juist de reden dat deze app bestaat.

        match /ankers/{ankerId} {
          allow get, list, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && withinSizeLimit()
            && isOneOf(request.resource.data.type, ankerTypes())
            && isString(request.resource.data.titel, 200)
            && request.resource.data.titel.size() > 0
            && isOneOf(request.resource.data.status,
                       ['verwacht', 'bevestigd', 'gepasseerd'])
            && optionalTimestamp(request.resource.data, 'verwachtOp')
            && optionalString(request.resource.data, 'bron', 300);
        }


        // ── betrokkenen/{betrokkeneId} ───────────────────────────────────
        // Partijen die de koper zelf inschakelt. Contactgegevens zijn bewust
        // optioneel: de schuif-impact werkt ook zonder e-mailadres.
        //
        // `aanlooptijdDagen` en `annuleertermijnDagen` zijn wél verplicht —
        // zonder die twee kan de urgentiebepaling niets. Bovengrens 3650 dagen
        // (10 jaar): ruim genoeg voor elke reële termijn, krap genoeg om
        // onzin-invoer en overflow in de rekenmotor te weren.

        match /betrokkenen/{betrokkeneId} {
          allow get, list, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && withinSizeLimit()
            && isString(request.resource.data.naam, 120)
            && request.resource.data.naam.size() > 0
            && isOneOf(request.resource.data.categorie,
                       ['installatie', 'afbouw', 'tuin', 'verhuizing',
                        'huidige_woning', 'nuts', 'financieel', 'overig'])
            && isInt(request.resource.data.aanlooptijdDagen, 0, 3650)
            && isInt(request.resource.data.annuleertermijnDagen, 0, 3650)
            && isOneOf(request.resource.data.communicatieregel,
                       ['direct', 'bij_aanzegging', 'handmatig'])
            && isOneOf(request.resource.data.waardenBron, ['voorstel', 'eigen'])
            && optionalString(request.resource.data, 'contactpersoon', 120)
            && optionalString(request.resource.data, 'email', 200)
            && optionalString(request.resource.data, 'telefoon', 40)
            && optionalString(request.resource.data, 'notitie', 2000);
        }


        // ── afspraken/{afspraakId} ───────────────────────────────────────
        // HIER STAAT GEEN AFSPRAAKDATUM, EN DIE MAG ER OOK NOOIT KOMEN.
        // Alleen `ankerType` + `offsetDagen`; de datum wordt afgeleid in
        // src/lib/planning.ts. Zie ADR-0008.
        //
        // De enige uitzondering is `gecommuniceerdeDatum`, en dat is geen
        // planning maar een feit over de buitenwereld: welke datum deze partij
        // als laatste van je kreeg. Het verschil tussen berekend en
        // gecommuniceerd ís de actielijst.
        //
        // `offsetDagen` mag negatief zijn (ervóór), bijv. huur opzeggen op
        // sleuteloverdracht −45.

        match /afspraken/{afspraakId} {
          allow get, list, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && withinSizeLimit()
            && isString(request.resource.data.betrokkeneId, 64)
            && request.resource.data.betrokkeneId.size() > 0
            && isString(request.resource.data.omschrijving, 300)
            && request.resource.data.omschrijving.size() > 0
            && isOneOf(request.resource.data.ankerType, ankerTypes())
            && isInt(request.resource.data.offsetDagen, -3650, 3650)
            && isOneOf(request.resource.data.status,
                       ['concept', 'voorlopig', 'bevestigd',
                        'afgerond', 'vervallen'])
            && optionalInt(request.resource.data, 'duurDagen', 0, 365)
            && optionalTimestamp(request.resource.data, 'gecommuniceerdeDatum')
            && optionalTimestamp(request.resource.data, 'gecommuniceerdOp')
            && optionalString(request.resource.data, 'waarschuwing', 1000)
            && optionalString(request.resource.data, 'notitie', 2000);
        }


        // ── phases/{phaseId} ─────────────────────────────────────────────

        match /phases/{phaseId} {
          allow get, list, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && withinSizeLimit()
            && isString(request.resource.data.titel, 200)
            && isOneOf(request.resource.data.type,
                       ['koop', 'notaris', 'financiering', 'bouw',
                        'oplevering', 'onderhoud', 'garantie'])
            && isOneOf(request.resource.data.status, ['open', 'bezig', 'klaar'])
            && optionalTimestamp(request.resource.data, 'streefdatum')
            && (!('volgorde' in request.resource.data)
                || (request.resource.data.volgorde is int
                    && request.resource.data.volgorde >= 0));
        }


        // ── tasks/{taskId} ───────────────────────────────────────────────

        match /tasks/{taskId} {
          allow get, list, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && withinSizeLimit()
            && isString(request.resource.data.titel, 300)
            && request.resource.data.titel.size() > 0
            && isOneOf(request.resource.data.status, ['open', 'klaar'])
            && isOneOf(request.resource.data.bron, ['handmatig', 'geparsed'])
            && optionalTimestamp(request.resource.data, 'deadline')
            && optionalString(request.resource.data, 'phaseId', 64)
            && optionalString(request.resource.data, 'notitie', 2000);
        }


        // ── meerwerk/{itemId} ────────────────────────────────────────────

        // ── meerwerk/{itemId} ────────────────────────────────────────────
        // De deadline kent drie vormen (ADR-0011). `sluiting` zegt welke, en
        // is verplicht: uit "welk veld is ingevuld" afleiden zou betekenen dat
        // een achtergebleven ankerveld stilzwijgend het gedrag bepaalt.
        //
        // De bijbehorende velden zijn allemaal optioneel gevalideerd in plaats
        // van voorwaardelijk verplicht. Reden: je noteert een meerwerkwens vaak
        // vóórdat je de datum kent, en een rule die dan al een datum eist maakt
        // het onmogelijk om iets alvast op te schrijven. Wat er staat moet
        // kloppen; het hoeft er nog niet te staan.

        match /meerwerk/{itemId} {
          allow get, list, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && withinSizeLimit()
            && isString(request.resource.data.omschrijving, 300)
            && request.resource.data.omschrijving.size() > 0
            && isOneOf(request.resource.data.status,
                       ['overweeg', 'besteld', 'bevestigd'])
            && isOneOf(request.resource.data.sluiting,
                       ['vaste_datum', 'bouwmoment', 'onbekend'])
            && optionalNumber(request.resource.data, 'bedrag')
            && optionalTimestamp(request.resource.data, 'sluitingsdatum')
            && (!('sluitingAnkerType' in request.resource.data)
                || isOneOf(request.resource.data.sluitingAnkerType, ankerTypes()))
            && optionalInt(request.resource.data, 'sluitingOffsetDagen', -3650, 3650)
            && optionalString(request.resource.data, 'phaseId', 64)
            && optionalString(request.resource.data, 'notitie', 2000);
        }


        // ── termijnen/{termId} — bouwdepot ───────────────────────────────

        match /termijnen/{termId} {
          allow get, list, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && withinSizeLimit()
            && isString(request.resource.data.omschrijving, 300)
            && request.resource.data.omschrijving.size() > 0
            && optionalNumber(request.resource.data, 'bedrag')
            && request.resource.data.gefactureerd is bool
            && request.resource.data.gedeclareerdBijBank is bool
            && request.resource.data.betaald is bool
            && optionalTimestamp(request.resource.data, 'gefactureerdOp')
            && optionalTimestamp(request.resource.data, 'gedeclareerdOp')
            && optionalTimestamp(request.resource.data, 'betaaldOp');
        }


        // ── gebreken/{defectId} — oplevering ─────────────────────────────

        // ── nabudget/{postId} ────────────────────────────────────────────
        // Wat er ná de oplevering nog komt: vloer, gordijnen, tuin, oprit.
        // Twee bedragen naast elkaar — wat je dacht en wat het werd. Dat
        // verschil is waar het overzicht om draait.

        match /nabudget/{postId} {
          allow get, list, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && withinSizeLimit()
            && isString(request.resource.data.omschrijving, 300)
            && request.resource.data.omschrijving.size() > 0
            && isOneOf(request.resource.data.status, ['geraamd', 'besteld', 'betaald'])
            && optionalNumber(request.resource.data, 'geraamd')
            && optionalNumber(request.resource.data, 'werkelijk')
            && optionalString(request.resource.data, 'notitie', 2000);
        }


        // ── onderdelen/{onderdeelId} — het woningdossier (ADR-0013) ──────
        // Wat er in de woning zit: merk, type, serienummer en de technische
        // gegevens die je bij een storing nodig hebt.
        //
        // TWEE GENESTE MAPS, EN DIE TELLEN ALLEBEI ALS ÉÉN VELD.
        // `specs` is een vrije sleutel-waardelijst en `registratieplicht` een
        // vast vormgegeven map. Zonder de eigen groottechecks hieronder is
        // `specs` een onbegrensde bak — precies de opslagplek die constraint
        // C2 uitsluit. Zelfde patroon als bij het woningpaspoort.
        //
        // `documentUrl` is een LINK naar waar het bestand bij de gebruiker
        // staat, nooit het bestand zelf (ADR-0005, ADR-0013 §3).

        match /onderdelen/{onderdeelId} {
          allow get, list, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && withinSize(16)
            && isString(request.resource.data.naam, 200)
            && request.resource.data.naam.size() > 0
            && isOneOf(request.resource.data.categorie, onderdeelCategorieen())
            && isOneOf(request.resource.data.montage,
                       ['vast_geinstalleerd', 'plug_and_play', 'nvt'])
            && request.resource.data.blijftBijWoning is bool
            && optionalString(request.resource.data, 'merk', 120)
            && optionalString(request.resource.data, 'type', 200)
            && optionalString(request.resource.data, 'serienummer', 120)
            && geldigeSpecs(request.resource.data)
            && optionalTimestamp(request.resource.data, 'installatieDatum')
            && optionalString(request.resource.data, 'installateurBetrokkeneId', 200)
            && optionalInt(request.resource.data, 'garantieMaanden', 0, 600)
            && geldigeRegistratieplicht(request.resource.data)
            && optionalString(request.resource.data, 'documentUrl', 2000)
            && optionalString(request.resource.data, 'notitie', 2000);
        }


        // ── onderhoudstaken/{taakId} — terugkerend werk (ADR-0014) ───────
        // De enige plek waar de mechaniek uit ADR-0008 niet volstond: onderhoud
        // herhaalt zich, bouwafspraken niet.
        //
        // ER STAAT GEEN VOLGENDE DATUM IN. Alleen `laatstUitgevoerdOp` (een
        // feit over het verleden) en `intervalDagen`; de volgende beurt is
        // altijd afgeleid. Zou hier een `volgendeOp` bijkomen, dan is dat een
        // schending van ADR-0008 en moet die eerst herzien worden.

        match /onderhoudstaken/{taakId} {
          allow get, list, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && withinSizeLimit()
            // DE ENIGE COLLECTIE MET EEN GESLOTEN VELDENLIJST, en dat is hier
            // bewust. Overal elders begrenzen de rules alleen het AANTAL
            // velden, zodat een onbekende veldnaam erdoorheen glipt. Bij een
            // onderhoudstaak is dat het verschil tussen wel en niet naleven van
            // ADR-0008: zonder `hasOnly` kan iemand doodleuk een `volgendeOp`
            // meesturen, en dan is de afgeleide datum ineens opgeslagen — de
            // fout die dit hele model probeert te voorkomen.
            //
            // Komt er een veld bij in `model.ts`, dan MOET het hier ook bij.
            // Vergeet je dat, dan weigert de write met een generieke
            // permissiefout. Dat is vervelend maar zichtbaar; het alternatief
            // is een schending die niemand opmerkt.
            && request.resource.data.keys().hasOnly([
                 'titel', 'omschrijving', 'onderdeelId', 'intervalDagen',
                 'voorkeursmaand', 'laatstUitgevoerdOp', 'waardenBron',
                 'waarschuwing'
               ])
            && isString(request.resource.data.titel, 300)
            && request.resource.data.titel.size() > 0
            // Ondergrens 1 dag: een interval van 0 zou de taak elke dag op de
            // lijst zetten. Bovengrens 50 jaar — daarboven is het geen
            // onderhoud meer maar een vervanging.
            && isInt(request.resource.data.intervalDagen, 1, 18250)
            && isOneOf(request.resource.data.waardenBron, ['voorstel', 'eigen'])
            && optionalString(request.resource.data, 'omschrijving', 2000)
            && optionalString(request.resource.data, 'onderdeelId', 200)
            && optionalInt(request.resource.data, 'voorkeursmaand', 1, 12)
            && optionalTimestamp(request.resource.data, 'laatstUitgevoerdOp')
            && optionalString(request.resource.data, 'waarschuwing', 2000);
        }


        // ── onderhoudslogboek/{logId} — wat er is gedaan ─────────────────
        // Wordt in dezelfde batch geschreven als het bijwerken van de taak.
        // `uitgevoerdOp` is verplicht: een logregel zonder datum zegt niets.

        match /onderhoudslogboek/{logId} {
          allow get, list, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && withinSizeLimit()
            && isString(request.resource.data.taakId, 200)
            && request.resource.data.taakId.size() > 0
            && request.resource.data.uitgevoerdOp is timestamp
            && optionalString(request.resource.data, 'onderdeelId', 200)
            && optionalString(request.resource.data, 'doorWie', 200)
            && optionalNumber(request.resource.data, 'kosten')
            && optionalString(request.resource.data, 'notitie', 2000);
        }


        // ── meters/{meterId} — WÁT je meet (ADR-0015) ────────────────────
        // De meter is een eigen document en geen tekstveld op de opname. Zou
        // de meternaam op elke stand staan, dan splitst één typefout
        // ("tussenmeter WP" naast "tussenmeter wp") de reeks stil in tweeën:
        // de trend klopt niet meer en er komt geen foutmelding.
        //
        // `soort` en `eenheid` zijn gesloten lijsten; `naam` is bewust vrij.
        // Een lijst die veroudert mag geen harde regel worden (ADR-0015 §2).

        match /meters/{meterId} {
          allow get, list, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && withinSizeLimit()
            // Gesloten veldenlijst, net als bij `meterstanden`. De veldlimiet
            // alleen laat dertien vrije veldnamen met onbegrensde lengte toe,
            // en dan is een `meterFoto` met base64 erin gewoon toegestaan —
            // precies wat constraint C2 en ADR-0010 §3 uitsluiten.
            && request.resource.data.keys().hasOnly([
                 'soort', 'naam', 'eenheid', 'meternummer', 'notitie',
                 'waardenBron'
               ])
            && isOneOf(request.resource.data.soort, metersoorten())
            && isOneOf(request.resource.data.eenheid, metereenheden())
            && isOneOf(request.resource.data.waardenBron, ['voorstel', 'eigen'])
            && optionalString(request.resource.data, 'naam', 200)
            // Bij `overig` is er geen bibliotheeklabel om op terug te vallen,
            // dus dan is de naam verplicht. Stond die eis alleen in het
            // formulier, dan levert elk ander schrijfpad (import, E8) een
            // naamloze meter op.
            && (request.resource.data.soort != 'overig'
                || (('naam' in request.resource.data)
                    && request.resource.data.naam is string
                    && request.resource.data.naam.size() > 0))
            && optionalString(request.resource.data, 'meternummer', 60)
            && optionalString(request.resource.data, 'notitie', 2000);
        }


        // ── meterstanden/{opnameId} — wat de meter AANWEES (ADR-0015) ────
        // Twee feiten: wat er stond en wanneer je gekeken hebt. Meer niet.
        //
        // ER STAAT GEEN VERBRUIK IN. Dat volgt uit twee opeenvolgende standen
        // en wordt in `lib/meterstanden.ts` elke keer opnieuw berekend. Zou
        // het hier opgeslagen worden, dan is elke correctie van een verkeerd
        // overgetypte stand een migratie — dezelfde fout als een vaste
        // afspraakdatum (ADR-0008).
        //
        // DIT IS NA `onderhoudstaken` DE TWEEDE COLLECTIE MET EEN GESLOTEN
        // VELDENLIJST, en om precies dezelfde reden: de veldlimiet alleen
        // houdt een meegestuurde `verbruik` niet tegen. Komt er een veld bij
        // in `model.ts`, dan MOET het hier ook bij — vergeet je dat, dan
        // weigert élke write met een generieke permissiefout.

        match /meterstanden/{opnameId} {
          allow get, list, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && withinSizeLimit()
            && request.resource.data.keys().hasOnly([
                 'meterId', 'opgenomenOp', 'stand', 'notitie'
               ])
            && isString(request.resource.data.meterId, 200)
            && request.resource.data.meterId.size() > 0
            && request.resource.data.opgenomenOp is timestamp
            // GEEN OPNAME IN DE TOEKOMST. Een verkeerd jaartal is de stilste
            // fout in deze collectie: het verbruik wordt dan gedeeld door een
            // veel te groot aantal dagen en de uitkomst ziet er plausibel uit.
            // Er komt geen enkele melding uit, want de stand zelf klopt.
            //
            // De marge van twee dagen is er omdat `opgenomenOp` UTC-middernacht
            // is: wie in Nederland om 00:30 zomertijd een stand van "vandaag"
            // noteert, schrijft een tijdstip weg dat op de server nog in de
            // toekomst ligt. Zonder marge weigert die write. Twee dagen is
            // ruim genoeg daarvoor en blokkeert nog steeds elke jaartalfout.
            && request.resource.data.opgenomenOp < request.time + duration.value(2, 'd')
            // Een meterstand loopt op vanaf 0 en kan niet negatief zijn. De
            // bovengrens is ruim: een gasmeter in m³ met drie decimalen komt
            // nooit in de buurt, en een tussenmeter op een laadpaal ook niet.
            && request.resource.data.stand is number
            && request.resource.data.stand >= 0
            && request.resource.data.stand <= 100000000
            && optionalString(request.resource.data, 'notitie', 2000);
        }


        match /gebreken/{defectId} {
          allow get, list, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && withinSizeLimit()
            && isString(request.resource.data.omschrijving, 1000)
            && request.resource.data.omschrijving.size() > 0
            && isOneOf(request.resource.data.status, ['open', 'hersteld'])
            && optionalString(request.resource.data, 'locatie', 200)
            && optionalTimestamp(request.resource.data, 'gemeldOp')
            && optionalTimestamp(request.resource.data, 'hersteltermijn');
        }
      }
    }

    // Geen catch-all. Alles wat hierboven niet expliciet staat, is geweigerd.
  }
}
