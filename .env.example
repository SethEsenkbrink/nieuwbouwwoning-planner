# ─────────────────────────────────────────────────────────────────────────────
# Nieuwbouwplanner — omgevingsvariabelen
#
# Kopieer dit bestand naar `.env.local` en vul je eigen waarden in.
# `.env.local` staat in .gitignore en mag NOOIT gecommit worden.
#
# Zie docs/2026-07-29-setup-checklist.md voor waar je deze waarden vandaan haalt.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase web-config ──────────────────────────────────────────────────────
# LET OP: alles met VITE_-prefix belandt in de browserbundle en is dus PUBLIEK.
# Dat is bij Firebase correct en bedoeld — de web-config is geen geheim. De
# beveiliging zit volledig in de Firestore security rules (firebase/firestore.rules).
#
# Firebase Console → Projectinstellingen → Algemeen → Je apps → Web-app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optioneel. messagingSenderId is alleen nodig voor push-notificaties, measurementId
# alleen voor Google Analytics. Beide gebruiken we (nog) niet — leeg laten mag.
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# NIET invullen: storageBucket. Firebase Storage wordt in dit project bewust
# nooit gebruikt (zie docs/decisions/ADR-0005).

# ── Firebase emulator (alleen lokaal) ────────────────────────────────────────
# Op "true" zetten om tegen de lokale Firestore/Auth-emulator te draaien in
# plaats van tegen het echte project. Handig bij het testen van security rules.
VITE_USE_FIREBASE_EMULATOR=false


# ─────────────────────────────────────────────────────────────────────────────
# SERVERSIDE GEHEIMEN — nooit een VITE_-prefix geven
#
# Deze waarden worden uitsluitend gelezen in netlify/functions/ via
# Netlify.env.get(). Zet ze in productie in de Netlify UI onder
# Site configuration → Environment variables. Zodra hier een VITE_-prefix voor
# komt te staan, staat het geheim in de publieke JS-bundle.
# ─────────────────────────────────────────────────────────────────────────────

# LLM-key voor de documentparser (fase 2 — nog niet in gebruik)
# ANTHROPIC_API_KEY=

# Mailprovider voor herinneringen (fase 3 — nog niet in gebruik)
# MAIL_API_KEY=
