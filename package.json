{
  "name": "woningdossier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "100% lokaal, end-to-end versleuteld dossier voor het complete leven van een woning.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:tokens": "node scripts/verify-tokens.mjs",
    "verify:headers": "node scripts/verify-headers.mjs",
    "verify:offline": "node scripts/verify-offline.mjs",
    "verify:crypto": "node scripts/verify-crypto.mjs",
    "verify:backup": "node scripts/verify-backup.mjs",
    "verify:bereikbaarheid": "node scripts/verify-bereikbaarheid.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run verify:tokens && npm run verify:headers && npm run verify:crypto && npm run verify:backup && npm run verify:bereikbaarheid && npm run build && npm run verify:offline"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "@brink/ui": "file:./brink-ui",
    "dexie": "^4.0.11",
    "fflate": "^0.8.3",
    "hash-wasm": "^4.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "smol-toml": "^1.7.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
